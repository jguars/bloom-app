<?xml version="1.0" encoding="utf-8"?>
<!-- Bloom · Clover (2x2): just her, with today's count. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <ImageView
        android:id="@+id/clover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_clover_image"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_clover_rest" />

    <TextView
        android:id="@+id/done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/widget_chip"
        android:fontFamily="@font/nunito"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="0/3"
        android:textColor="#2E3826"
        android:textSize="13sp"
        android:textStyle="bold" />
</FrameLayout>
